{
  "name": "virtualpc",
  "version": "1.0.0",
  "description": "VirtualPC - Autonomous Agent System with LightRAG, Kafka, and API optimization",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "bench:ideagraph": "ts-node scripts/run-ideagraph-benchmark.ts",
    "test:e2e": "ts-node tests/e2e/selenium-launcher.ts",
    "test:e2e:headless": "HEADLESS=true ts-node tests/e2e/selenium-launcher.ts",
    "test:e2e:chrome": "ts-node tests/e2e/selenium-launcher.ts -- --browser chrome",
    "test:e2e:firefox": "ts-node tests/e2e/selenium-launcher.ts -- --browser firefox",
    "demo:interactive": "ts-node tests/e2e/interactive-demo.ts",
    "demo:run": "bash run-interactive-demo.sh",
    "setup:selenium": "bash setup-selenium-ubuntu.sh",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "docker:build": "docker build -t custom-virtualpc:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:migrate": "ts-node src/migrations/index.ts",
    "skill:register": "ts-node src/skills/register.ts",
    "setup:models": "ts-node scripts/setup-model-roster.ts",
    "smoke-deliberation-gates": "node scripts/infisical-wrap.mjs --no-secrets -- node --import tsx/esm scripts/smoke-deliberation-gates.mts",
    "smoke-deliberation-gates:example": "bash scripts/run-smoke-on-example.sh"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.15.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "csv-parse": "^7.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.1.0",
    "neo4j-driver": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.1.0",
    "style-loader": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1",
    "webpack": "^5.106.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.17.6",
    "@types/selenium-webdriver": "^4.35.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "chromedriver": "^149.0.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "pdfkit": "^0.19.0",
    "prettier": "^3.1.1",
    "selenium-webdriver": "^4.43.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "webdriver": "^9.29.0",
    "webpack-cli": "^6.0.1"
  },
  "optionalDependencies": {
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  }
}
