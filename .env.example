# VirtualPC Autonomous Agent System - Environment Configuration

# Server
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# Neo4j Graph Database (LightRAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# REQUIRED — set a strong password. App refuses to start in production if empty.
NEO4J_PASSWORD=

# Kafka Message Queue
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# MQTT bridge (opt-in) — group/vote/fact events mirror to vpc/* topics
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# JWT Authentication
# REQUIRED — generate a strong random secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=
TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cost Tracking
DAILY_BUDGET=50
MONTHLY_BUDGET=1500
COST_REDUCTION_TARGET=0.87

# Model Router
TIER1_MODELS=qwen-32b-instruct,deepseek-r1-7b,phi-4
TIER2_MODELS=mistral-7b,llama-2-7b
TIER3_MODELS=claude-opus-4.6,gpt-4-turbo

# LightRAG
LIGHTRAG_CACHE_SIZE=1000
LIGHTRAG_CACHE_TTL=3600

# Logging
LOG_DIR=./logs
DATA_DIR=./data

# API Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
# Set an explicit allowed origin in production; '*' is unsafe with credentials.
CORS_ORIGIN=http://localhost:3100

# Paperclip Integration
PAPERCLIP_API_URL=http://localhost:3000
# REQUIRED if Paperclip is enabled — leave empty to disable the integration.
PAPERCLIP_API_TOKEN=

# Agents
AGENT_HEARTBEAT_INTERVAL=30000
AGENT_MAX_CONCURRENT_TASKS=5

# Contributor Backlog Hub — GitHub Issues sync (opt-in)
# GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_OWNER=your-org-or-username
# GITHUB_REPO=your-repository
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Contributor Backlog Hub — GitLab Issues sync (opt-in)
# GITLAB_TOKEN=glpat_your_project_token
# GITLAB_PROJECT_ID=12345678
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_WEBHOOK_SECRET=your-webhook-secret

# Lightning Network — off-chain payment channels (opt-in overrides)
# LIGHTNING_NETWORK_ID=vpc-mainnet
# LIGHTNING_MAX_CHANNELS=100000

# Protocol versioning + fork registry
# PROTOCOL_NETWORK_ID=vpc-mainnet
